# ShipGuard Environment Variables

# Backend JWT Authentication Secret Key
JWT_SECRET=replace-with-a-random-64-char-secret

# Database file location (SQLite)
SHIPGUARD_DB_PATH=data/shipguard.db

# Uploads directory location
SHIPGUARD_UPLOAD_DIR=data/uploads

# Server Port and Host
HOST=127.0.0.1
PORT=8000

# Hourly Scan-Gap Scheduler Interval (in seconds, default 3600 = 1 hour)
SCHEDULER_INTERVAL_SECONDS=3600

